rule multiqc:
    input:
        expand(
            "results/fastp/{sample}_fastp.json",
            sample=sample_data.index.tolist(),
        ), 
        expand(
           "results/fastqc/{sample}_R1.html",
           sample=sample_data.index.tolist(),
        ),
        expand(
            "results/fastqc/{sample}_R2.html",
            sample=sample_data.index.tolist(),
        ),
        expand(
            "results/sortmerna/{sample}_sortmerna_stats.log",
            sample=sample_data.index.tolist(),
        ),
        "results/cat_reads/seqkit_stats.tsv",
        "results/busco/short_summary.txt",
        "results/salmon/quant.sf",
        "results/salmon/lib_format_counts.json",
        config="config/config_multiqc.yaml",
    output:
        "results/multiqc.html",
        directory("results/multiqc_data"),
    params:
        extra="--verbose",  # Optional: extra parameters for multiqc.
    log:
        "logs/multiqc.log",
    wrapper:
        "v7.5.0/bio/multiqc"
